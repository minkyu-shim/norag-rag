# Copy this file to .env and replace with your real keys.

# For google gemini, go to https://aistudio.google.com/app/api-keys 
# and create an API key, then copy and paste it here.
export GOOGLE_API_KEY="your_google_api_key_here"

# V4 (optional). USD per million tokens, copied from your LLM provider's price page: shows the cost in the trace.
# LLM_PRICE_INPUT_PER_MTOK=0
# LLM_PRICE_OUTPUT_PER_MTOK=0
# Set to 0 to switch personal data redaction off (for comparison only).
# REDACT_PERSONAL_DATA=1
